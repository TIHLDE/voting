# PostgreSQL connection string (required).
# Default matches docker-compose.yml: `bun run db:up` starts Postgres with
# user "vedtatt", password "vedtatt", database "vedtatt" on port 5432.
DATABASE_URL=postgresql://vedtatt:vedtatt@localhost:5432/vedtatt

# Better Auth secret (required). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL for Better Auth (optional). Defaults to the request origin.
# Set it in production, e.g. https://vedtatt.tihlde.org
BETTER_AUTH_URL=

# Application name shown in the UI (optional). Defaults to "TIHLDE Voting".
VITE_APP_NAME=
