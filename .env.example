# PostgreSQL connection string (required).
# Default matches docker-compose.yml: `bun run db:up` starts Postgres with
# user "vedtatt", password "vedtatt", database "vedtatt" on port 5432.
DATABASE_URL=postgresql://vedtatt:vedtatt@localhost:5432/vedtatt

# Better Auth secret (required). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL for Better Auth (optional). Defaults to the request origin.
# Set it in production, e.g. https://vedtatt.tihlde.org
BETTER_AUTH_URL=

# Photon OAuth login (optional). Register the client under /admin/oauth-clients
# on tihlde.org with redirect URI <origin>/api/auth/callback/photon.
# Without these, Photon login is unavailable and only email/password works.
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=
PHOTON_ISSUER=https://photon.tihlde.org/api/auth

# Invitation emails go through Photon's email API (POST /api/email/send), so
# they share Photon's sender and template. The key is Photon's EMAIL_API_KEY.
# Without it, invites are still created but no email is sent.
PHOTON_API_URL=https://photon.tihlde.org/api
PHOTON_EMAIL_API_KEY=

# Application name shown in the UI (optional). Defaults to "TIHLDE Voting".
VITE_APP_NAME=
